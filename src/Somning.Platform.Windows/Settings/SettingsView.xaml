<Window x:Class="Somning.Platform.Windows.Settings.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Somning — Configurações" Width="456" SizeToContent="Height" WindowStartupLocation="CenterScreen"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 Foreground="#ECEFF2" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <!-- Single swap point for the brand mark (logo is being redesigned). -->
  <BitmapImage x:Key="BrandLogo" UriSource="pack://application:,,,/Somning.Platform.Windows;component/Branding/somning-logo.png"/>

  <Color x:Key="AccentColor">#5CE1E6</Color>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="Muted" Color="#8E99A4"/>
  <SolidColorBrush x:Key="Caption" Color="#6F7A85"/>
  <SolidColorBrush x:Key="InsetFill" Color="#59000000"/>
  <SolidColorBrush x:Key="InsetRim" Color="#2EFFFFFF"/>
  <SolidColorBrush x:Key="InsetRimHover" Color="#4DFFFFFF"/>

  <!-- Glass body. Opaque-ish fallback; GlassBackdrop swaps in GlassFillAcrylic when real blur is active. -->
  <LinearGradientBrush x:Key="GlassFillSolid" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#F21B1E23" Offset="0"/><GradientStop Color="#F4111316" Offset="0.45"/><GradientStop Color="#F70A0B0D" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassFillAcrylic" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#C21B1E23" Offset="0"/><GradientStop Color="#CC111316" Offset="0.45"/><GradientStop Color="#DB0A0B0D" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RimBrush" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#D9EEF1F4" Offset="0"/><GradientStop Color="#59B9C0C7" Offset="0.12"/><GradientStop Color="#26FFFFFF" Offset="0.55"/><GradientStop Color="#73C9CED4" Offset="1"/>
  </LinearGradientBrush>

  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SectionCaption" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Caption}"/><Setter Property="Margin" Value="2,0,0,7"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="2,5,0,0"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="#B9C2CB"/><Setter Property="Padding" Value="2,0,0,5"/><Setter Property="FontSize" Value="12"/></Style>

  <!-- Inset field shell shared by TextBox and PasswordBox. -->
  <ControlTemplate x:Key="InsetFieldTemplate" TargetType="Control">
   <Border x:Name="Shell" Background="{StaticResource InsetFill}" BorderBrush="{StaticResource InsetRim}" BorderThickness="1" CornerRadius="9">
    <Grid>
     <Border CornerRadius="9,9,0,0" Height="6" VerticalAlignment="Top" Background="#1A000000" IsHitTestVisible="False"/>
     <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center" Focusable="False"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource InsetRimHover}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#ECEFF2"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="Height" Value="34"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template" Value="{StaticResource InsetFieldTemplate}"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#ECEFF2"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionBrush" Value="{StaticResource Accent}"/><Setter Property="Height" Value="34"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template" Value="{StaticResource InsetFieldTemplate}"/></Style>

  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E6EAEE"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="10,7" Margin="4,1"><ContentPresenter/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#1FFFFFFF"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="#ECEFF2"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Shell" Background="{StaticResource InsetFill}" BorderBrush="{StaticResource InsetRim}" BorderThickness="1" CornerRadius="9"><Path x:Name="Chevron" Data="M0,0 L4.5,4.5 9,0" Stroke="#9AA5B0" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,13,0"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource InsetRimHover}"/><Setter TargetName="Chevron" Property="Stroke" Value="#E6EAEE"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></ToggleButton.Template></ToggleButton>
   <Border x:Name="FocusRim" BorderThickness="1" CornerRadius="9" BorderBrush="Transparent" IsHitTestVisible="False"/>
   <ContentPresenter IsHitTestVisible="False" Margin="11,0,34,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
   <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240" Background="#F5131518" BorderBrush="#4DC9CED4" BorderThickness="1" CornerRadius="10" Padding="0,4" Margin="0,0,8,8">
     <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.55" Color="Black"/></Border.Effect>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
    </Border>
   </Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRim" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

  <!-- CheckBox restyled as a glass switch: label left, knob right. -->
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DDE2E7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid Background="Transparent" MinHeight="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" Margin="2,0,12,0"/>
    <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="{StaticResource InsetFill}" BorderBrush="{StaticResource InsetRim}" BorderThickness="1" VerticalAlignment="Center">
     <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0">
      <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C8CDD2" Offset="0"/><GradientStop Color="#7E868E" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
     </Ellipse>
    </Border>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
     <Setter TargetName="Knob" Property="Fill" Value="#F2FBFC"/>
     <Setter TargetName="Track" Property="Background" Value="#4D5CE1E6"/><Setter TargetName="Track" Property="BorderBrush" Value="#B35CE1E6"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>

  <Style TargetType="Button"><Setter Property="Padding" Value="16,0"/><Setter Property="Height" Value="34"/><Setter Property="Foreground" Value="#DDE2E7"/><Setter Property="Background" Value="#14FFFFFF"/><Setter Property="BorderBrush" Value="#38FFFFFF"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#24FFFFFF"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#0AFFFFFF"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="#0B1A1C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#B8F3F5"/>
   <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#8FEDF0" Offset="0"/><GradientStop Color="#4CC9CF" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="Glow" CornerRadius="10" Background="{StaticResource Accent}" Opacity="0.35" Margin="2,3,2,-1"><Border.Effect><BlurEffect Radius="10"/></Border.Effect></Border>
     <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glow" Property="Opacity" Value="0.6"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Glow" Property="Opacity" Value="0.7"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button"><Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Disc" CornerRadius="14" Background="#0FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"><Path x:Name="Cross" Data="M0,0 L8,8 M8,0 L0,8" Stroke="#9AA5B0" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Background" Value="#26FFFFFF"/><Setter TargetName="Cross" Property="Stroke" Value="White"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#0DFFFFFF"/><Setter Property="BorderBrush" Value="#1AFFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 </Window.Resources>

 <!-- Outer margin leaves room for the soft drop shadow (fallback mode). -->
 <Grid x:Name="Frame" Margin="18">
  <Grid x:Name="ShadowHost" IsHitTestVisible="False">
   <Border x:Name="ShadowShape" CornerRadius="22" Background="Black" Opacity="0.7" Margin="2,8,2,-6"><Border.Effect><BlurEffect Radius="26"/></Border.Effect></Border>
  </Grid>

  <Grid x:Name="Glass">
   <Border x:Name="GlassBody" CornerRadius="22" Background="{DynamicResource GlassFill}"/>
   <!-- Inner shadow: dark blurred rim pulled inside the glass. -->
   <Grid x:Name="InnerShadowHost" IsHitTestVisible="False">
    <Border CornerRadius="22" BorderBrush="#B3000000" BorderThickness="7" Margin="-3"><Border.Effect><BlurEffect Radius="14"/></Border.Effect></Border>
   </Grid>
   <!-- Specular top sheen and highlight streak, like the drop. -->
   <Border CornerRadius="22,22,60,60" Height="120" VerticalAlignment="Top" IsHitTestVisible="False">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#21FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
   </Border>
   <Ellipse Height="20" Margin="70,3,70,0" VerticalAlignment="Top" IsHitTestVisible="False">
    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
   </Ellipse>
   <Border CornerRadius="22" BorderThickness="1" BorderBrush="{StaticResource RimBrush}" IsHitTestVisible="False"/>
   <Border CornerRadius="21" BorderThickness="1" BorderBrush="#59000000" Margin="1" IsHitTestVisible="False"/>

   <Grid Margin="22,14,22,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid x:Name="Header" Background="Transparent" Margin="-6,0,-6,14" Cursor="SizeAll">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image x:Name="BrandImage" Source="{StaticResource BrandLogo}" Width="34" Height="34" Margin="0,0,10,0" AutomationProperties.Name="Logo Somning: gota de vidro com onda de voz"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="somning" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="Configurações" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,-1,0,0"/>
     </StackPanel>
     <Border Grid.Column="2" BorderBrush="#4D5CE1E6" BorderThickness="1" CornerRadius="9" Padding="8,1" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="1.0" Foreground="{StaticResource Accent}" FontSize="11"/></Border>
     <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CloseButton}" ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar" IsTabStop="False" Cursor="Hand"/>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Panel}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Atalho de voz" FontWeight="SemiBold"/><TextBlock Text="Segure para falar, toque para alternar. Fixo nesta versão." FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,2,10,0"/></StackPanel>
      <Border Grid.Column="1" Background="#73000000" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
       <TextBlock x:Name="HotkeyText" Text="Ctrl + Shift + Espaço" FontSize="12" FontFamily="Segoe UI Semibold" Foreground="{StaticResource Accent}" TextWrapping="NoWrap" AutomationProperties.Name="Atalho atual"/>
      </Border>
     </Grid>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
     <TextBlock Text="ENTRADA" Style="{StaticResource SectionCaption}"/>
     <Label Content="_Microfone" Target="{Binding ElementName=DeviceCombo}"/>
     <ComboBox x:Name="DeviceCombo" AutomationProperties.Name="Microfone"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,0,0,12">
     <TextBlock Text="TRANSCRIÇÃO" Style="{StaticResource SectionCaption}"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><Label Content="_Processamento" Target="{Binding ElementName=ProviderCombo}"/>
       <ComboBox x:Name="ProviderCombo" AutomationProperties.Name="Provedor de transcrição"><ComboBoxItem Content="Local · Whisper"/><ComboBoxItem Content="Nuvem · Groq"/><ComboBoxItem Content="Nuvem · OpenAI"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="2"><Label Content="C_have de API" Target="{Binding ElementName=ApiKeyBox}"/><PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="Chave de API do provedor"/></StackPanel>
     </Grid>
     <TextBlock x:Name="ProviderHint" Style="{StaticResource Hint}" Margin="2,6,0,10"/>
     <Label Content="_Vocabulário personalizado" Target="{Binding ElementName=VocabularyBox}"/>
     <TextBox x:Name="VocabularyBox" AutomationProperties.Name="Vocabulário personalizado"/>
     <TextBlock Text="Nomes e termos que você usa, separados por vírgulas." Style="{StaticResource Hint}"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Margin="0,0,0,16">
     <TextBlock Text="COMPORTAMENTO" Style="{StaticResource SectionCaption}"/>
     <Border Background="#0DFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,3">
      <StackPanel>
       <CheckBox x:Name="AutoPasteCheck" Content="_Colar automaticamente no aplicativo ativo" AutomationProperties.Name="Colar automaticamente no aplicativo ativo"/>
       <Rectangle Height="1" Fill="#14FFFFFF"/>
       <CheckBox x:Name="SoundCuesCheck" Content="Sons de _início e término" AutomationProperties.Name="Sons de início e término"/>
       <Rectangle Height="1" Fill="#14FFFFFF"/>
       <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar com o _Windows" AutomationProperties.Name="Iniciar com o Windows"/>
      </StackPanel>
     </Border>
    </StackPanel>

    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="SaveHint" Text="Enter salva · Esc fecha" Foreground="{StaticResource Caption}" VerticalAlignment="Center" FontSize="11.5"/>
     <Button x:Name="CancelButton" Grid.Column="1" Content="_Cancelar" IsCancel="True" Margin="0,0,8,0"/>
     <Button x:Name="SaveButton" Grid.Column="2" Content="_Salvar" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="20,0"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
