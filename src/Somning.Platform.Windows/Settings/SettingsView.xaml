<Window x:Class="Somning.Platform.Windows.Settings.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Somning — Configurações" Width="760" Height="810" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterScreen"
 Background="#12161C" Foreground="#EFF2F5" FontFamily="Segoe UI" FontSize="14" ResizeMode="CanResize">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A8B3BF"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Label"><Setter Property="Foreground" Value="#C4CED8"/><Setter Property="Padding" Value="0,0,0,7"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#12171E"/><Setter Property="Foreground" Value="#EFF2F5"/><Setter Property="BorderBrush" Value="#46515F"/><Setter Property="Padding" Value="11,8"/><Setter Property="CaretBrush" Value="#91E1EC"/><Setter Property="MinHeight" Value="38"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#91E1EC"/></Trigger></Style.Triggers></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="#12171E"/><Setter Property="Foreground" Value="#EFF2F5"/><Setter Property="BorderBrush" Value="#46515F"/><Setter Property="Padding" Value="11,8"/><Setter Property="CaretBrush" Value="#91E1EC"/><Setter Property="MinHeight" Value="38"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#202832"/><Setter Property="Foreground" Value="#F0F3F5"/><Setter Property="Padding" Value="12,9"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#344753"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="40"/><Setter Property="Foreground" Value="#F0F3F5"/><Setter Property="Background" Value="#12171E"/><Setter Property="BorderBrush" Value="#46515F"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#12171E" BorderBrush="#46515F" BorderThickness="1" CornerRadius="5"><Grid><Path Data="M0,0 L5,5 10,0" Stroke="#ACBBC8" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter IsHitTestVisible="False" Margin="12,7,36,7" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
   <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="250" Background="#202832" BorderBrush="#586878" BorderThickness="1" CornerRadius="5"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#91E1EC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="20,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Background" Value="#29323D"/><Setter Property="Foreground" Value="#EDF3F5"/><Setter Property="BorderBrush" Value="#52616F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E7EDF2"/><Setter Property="Margin" Value="0,9,0,9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="20" Height="20" BorderThickness="1" BorderBrush="#70818F" Background="#12171E" CornerRadius="4" VerticalAlignment="Top" Margin="0,1,12,0"><Path x:Name="Tick" Visibility="Collapsed" Data="M3,9 L7,13 15,5" Stroke="#10191F" StrokeThickness="2"/></Border><ContentPresenter RecognizesAccessKey="True"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#91E1EC"/><Setter TargetName="Box" Property="BorderBrush" Value="#91E1EC"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1B222B"/><Setter Property="BorderBrush" Value="#35404D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22,18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="30,22,30,18"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Image x:Name="BrandImage" Width="62" Height="62" HorizontalAlignment="Left" AutomationProperties.Name="Logo Somning: gota de vidro com onda de voz"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="somning" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Sua voz, em palavras." Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel>
   <Border Grid.Column="2" BorderBrush="#455662" BorderThickness="1" CornerRadius="12" Padding="11,4" VerticalAlignment="Top" Margin="0,9,0,0"><TextBlock Text="1.0" Foreground="#A8E6EE" FontSize="12"/></Border>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,0,30,8" CanContentScroll="False">
   <StackPanel>
    <TextBlock Text="Configurações" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="Ajuste o Somning ao seu jeito de trabalhar." Foreground="{StaticResource Muted}" Margin="0,0,0,21"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Atalho" Style="{StaticResource SectionTitle}"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Atalho de voz" FontWeight="SemiBold"/><TextBlock Text="Segure para falar ou toque para alternar." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,15,0"/></StackPanel><Border Grid.Column="1" Background="#11171D" BorderBrush="#4E616D" BorderThickness="1" CornerRadius="5" Padding="12,8" VerticalAlignment="Center"><TextBlock x:Name="HotkeyText" Text="Ctrl + Shift + Espaço" FontSize="13" Foreground="#D4E7EC" AutomationProperties.Name="Atalho atual"/></Border></Grid>
     <TextBlock Text="Nesta versão o atalho é fixo." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Microfone" Style="{StaticResource SectionTitle}"/>
     <Label Content="_Dispositivo de entrada" Target="{Binding ElementName=DeviceCombo}"/><ComboBox x:Name="DeviceCombo" AutomationProperties.Name="Microfone"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Motor e nuvem" Style="{StaticResource SectionTitle}"/>
     <Label Content="_Processamento" Target="{Binding ElementName=ProviderCombo}"/><ComboBox x:Name="ProviderCombo" AutomationProperties.Name="Provedor de transcrição"><ComboBoxItem Content="Local · Whisper"/><ComboBoxItem Content="Nuvem · Groq"/><ComboBoxItem Content="Nuvem · OpenAI"/></ComboBox>
     <TextBlock x:Name="ProviderHint" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,15"/>
     <Label Content="_Chave de API" Target="{Binding ElementName=ApiKeyBox}"/><PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="Chave de API do provedor"/>
     <Label Content="_Vocabulário personalizado" Target="{Binding ElementName=VocabularyBox}" Margin="0,17,0,0"/><TextBox x:Name="VocabularyBox" AutomationProperties.Name="Vocabulário personalizado"/>
     <TextBlock Text="Nomes e termos que você usa, separados por vírgulas." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
     <CheckBox x:Name="AutoPasteCheck" Content="_Colar automaticamente no aplicativo ativo" AutomationProperties.Name="Colar automaticamente no aplicativo ativo"/>
     <CheckBox x:Name="SoundCuesCheck" Content="Sons de _início e término" AutomationProperties.Name="Sons de início e término"/>
     <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar com o _Windows" AutomationProperties.Name="Iniciar com o Windows"/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#171D25" BorderBrush="#35404D" BorderThickness="0,1,0,0" Padding="30,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SaveHint" Text="As alterações são aplicadas ao salvar." Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" Margin="0,0,20,0"/><Button x:Name="CancelButton" Grid.Column="1" Content="_Cancelar" Margin="0,0,10,0"/><Button x:Name="SaveButton" Grid.Column="2" Content="_Salvar alterações" IsDefault="True" Background="#96DEE8" Foreground="#10212A" BorderBrush="#BFEAF0" FontWeight="SemiBold"/></Grid></Border>
 </Grid>
</Window>
